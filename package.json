{
  "name": "orbitping",
  "version": "1.0.0",
  "description": "High-reliability heartbeat and dead-man switch monitor for scheduled jobs, cron jobs, and background workers.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src/ test/ scripts/",
    "lint:fix": "eslint src/ test/ scripts/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts",
    "gen-key": "tsx scripts/gen-key.ts",
    "make-admin": "tsx scripts/make-admin.ts",
    "bench:cron": "tsx scripts/bench-cron.ts"
  },
  "keywords": [
    "cron",
    "monitoring",
    "heartbeat",
    "dead-mans-switch",
    "scheduled-jobs",
    "alerts"
  ],
  "author": "OrbitPing Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@hono/zod-validator": "^0.4.3",
    "@prisma/client": "^6.4.1",
    "croner": "^9.0.0",
    "cronstrue": "^2.54.0",
    "dotenv": "^16.4.7",
    "hono": "^4.7.2",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.9",
    "eslint": "^9.21.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.0.7"
  }
}
