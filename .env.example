# ==============================================================================
# OrbitPing Environment Configuration Template (.env.example)
# Copy to .env and replace placeholder values with your real configuration.
# Never commit .env containing real secrets into version control.
# ==============================================================================



# Runtime & Server
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
PING_HOST=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://orbitping:orbitping_dev_password@localhost:5433/orbitping_dev?schema=public"
DIRECT_URL="postgresql://orbitping:orbitping_dev_password@localhost:5433/orbitping_dev?schema=public"

# Session & Security
# Generate using: npm run gen-key
SESSION_SECRET=change_me_to_a_random_64_character_hex_string_for_session_cookies
# 32-byte AES-256-GCM key in base64
ENC_KEY_V1=change_me_to_a_random_32_byte_base64_string_for_channel_secrets
ENC_KEY_CURRENT=v1

# Authentication (GitHub OAuth)
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Email Alerts (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
MAIL_FROM="OrbitPing <alerts@mail.orbitping.example>"
EMAIL_GLOBAL_DAILY_CAP=90

# Chat Alerts (Telegram)
TELEGRAM_BOT_TOKEN=fkorfnokrenvoirinvion
TELEGRAM_BOT_USERNAME=OrbitPingBot
TELEGRAM_WEBHOOK_SECRET=random_32_character_telegram_secret_string

# Form Protection (Cloudflare Turnstile)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Payments & Billing (Paddle, Lemon Squeezy, or Polar)
BILLING_PROVIDER=polar
BILLING_API_KEY=polar_api_key_placeholder
BILLING_WEBHOOK_SECRET=polar_webhook_secret_placeholder
PRICE_ID_PRO_MONTHLY=price_pro_monthly_id
PRICE_ID_PRO_YEARLY=price_pro_yearly_id
PRICE_ID_PLUS_MONTHLY=price_plus_monthly_id
PRICE_ID_PLUS_YEARLY=price_plus_yearly_id

# Admin Configuration
ADMIN_EMAILS=admin@orbitping.example

# Outage & Self-Monitoring Watchers
WATCHER_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000000
SYNTHETIC_CHECK_UUID=00000000-0000-0000-0000-000000000001

# Sentry Exception Tracking (Optional)
SENTRY_DSN=

# Automated Backups (Object Storage: R2 or B2)
BACKUP_BUCKET=orbitping-backups
BACKUP_KEY_ID=
BACKUP_SECRET=
